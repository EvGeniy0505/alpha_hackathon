  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "ApplicationInput": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "tax_id": {
            "type": "string",
            "pattern": "^(?:[0-9]{10}|[0-9]{12})$",
            "description": "Синтетический ИНН; контрольная сумма не проверяется."
          },
          "product_id": {
            "type": "string",
            "enum": [
              "working_capital",
              "equipment"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 100000,
            "maximum": 10000000,
            "description": "Рубли. Дополнительно проверяется диапазон выбранного продукта."
          },
          "term_months": {
            "type": "integer",
            "minimum": 6,
            "maximum": 60,
            "description": "Дополнительно проверяется диапазон продукта."
          },
          "purpose": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "revenue_monthly": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000000
          },
          "expenses_monthly": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000000
          },
          "existing_payment": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000000
          },
          "business_months": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200
          },
          "consent": {
            "type": "boolean",
            "default": false,
            "description": "Обязательно true перед отправкой."
          },
          "clarification": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          }
        },
        "required": [
          "company_name",
          "tax_id",
          "product_id",
          "amount",
          "term_months",
          "purpose",
          "revenue_monthly",
          "expenses_monthly",
          "existing_payment",
          "business_months"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "enum": [
              "client",
              "client2",
              "analyst"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "bank"
            ]
          }
        },
        "required": [
          "username",
          "role"
        ]
      },
      "Offer": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "term_months": {
            "type": "number"
          },
          "annual_rate": {
            "type": "number"
          },
          "monthly_payment": {
            "type": "number"
          }
        },
        "required": [
          "amount",
          "term_months",
          "annual_rate",
          "monthly_payment"
        ]
      },
      "Decision": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checking",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "signed",
              "funded"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Offer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "reasons",
          "offer"
        ]
      },
      "Checks": {
        "type": "object",
        "properties": {
          "registry_status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "unknown"
            ]
          },
          "overdue_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "const": "local_synthetic"
          }
        },
        "required": []
      },
      "Score": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "object",
            "properties": {
              "free_cash_flow": {
                "type": "number"
              },
              "payment_coverage": {
                "type": "number"
              },
              "business_months": {
                "type": "number"
              },
              "covers_payment": {
                "type": "boolean"
              },
              "has_approval_buffer": {
                "type": "boolean"
              }
            },
            "required": []
          },
          "monthly_payment": {
            "type": "number"
          },
          "version": {
            "type": "string"
          }
        },
        "required": []
      },
      "Alternative": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "term_months": {
            "type": "integer"
          },
          "monthly_payment": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checking",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "signed",
              "funded"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": []
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/Checks"
          },
          "score": {
            "$ref": "#/components/schemas/Score"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "alternative": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Alternative"
              },
              {
                "type": "null"
              }
            ]
          },
          "bank_decision": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "checking",
                  "manual_review",
                  "needs_info",
                  "approved",
                  "rejected",
                  "signed",
                  "funded"
                ]
              },
              "note": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "offer": {
                "$ref": "#/components/schemas/Offer"
              }
            },
            "required": []
          }
        },
        "required": []
      },
      "Event": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checking",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "signed",
              "funded"
            ]
          },
          "actor": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": []
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "checking",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "signed",
              "funded"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/ApplicationInput"
          },
          "assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Assessment"
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": []
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
